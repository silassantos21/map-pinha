# Copie para mobile/.env e preencha — ver README.md pro passo a passo completo.

# IP local da máquina rodando o backend (não "localhost" — o celular físico
# não é a mesma máquina). No Windows: `ipconfig` > "Endereço IPv4" da rede
# Wi-Fi. Backend roda na porta 8000 (ver docker-compose.yml).
EXPO_PUBLIC_API_URL=http://192.168.0.X:8000

# Mesmo Client ID OAuth tipo "Web" que o NextAuth já usa
# (frontend/.env.local, GOOGLE_CLIENT_ID) — Google Cloud Console > APIs &
# Services > Credentials. Precisa ser o MESMO valor configurado em
# backend/.env como GOOGLE_MOBILE_CLIENT_ID. O login mobile (LoginScreen.tsx)
# usa esse client "Web" via expo-auth-session (navegador) — não existe
# client tipo "Android" nesse fluxo. O Google não aceita mais um esquema
# customizado (`mapinha://`) como redirect URI, então é preciso cadastrar
# `https://mapinha-iota.vercel.app/mobile-auth-redirect.html` (a página-ponte
# em frontend/public/) nas "Authorized redirect URIs" desse client Web.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Cloud Console > APIs & Services > Library > ativar "Maps SDK for
# Android" > Credentials > criar uma API key (pode restringir por SHA-1 +
# nome do pacote, igual o client OAuth Android acima).
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# Opcional — mesma chave da Stadia Maps já usada no frontend web
# (NEXT_PUBLIC_STADIA_API_KEY). Sem ela, os tiles ainda funcionam em
# localhost/rede local (Stadia só exige key fora disso).
EXPO_PUBLIC_STADIA_API_KEY=
