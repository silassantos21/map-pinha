# Backend (FastAPI) — copie para backend/.env e preencha
# Usado tanto pelo docker-compose (com overrides de host) quanto por execução local

# Porta 5433 (não 5432) no host — a 5432 já está em uso por outro projeto neste ambiente.
# Dentro do docker-compose, o backend acessa via "db:5432" (rede interna), sobrescrito automaticamente.
DATABASE_URL=postgresql+psycopg://mappin:mappin@localhost:5433/mappin
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (storage de mídia — Sprint 1)
# Account ID: Cloudflare Dashboard > R2 > Overview
# Access Key ID / Secret: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Anthropic — agentes de IA (Sprint 5, roda via BackgroundTasks do FastAPI,
# não via Celery — ver SPRINTS.md Sprint 5/Decisões)
ANTHROPIC_API_KEY=sk-ant-...

# Segredo compartilhado com o frontend (mesmo valor em frontend/.env.local).
# Usado só para o backend confiar nas chamadas do NextAuth ao endpoint /auth/sync.
# Gere com: openssl rand -hex 32
INTERNAL_API_SECRET=

# Sentry (rastreamento de erros) — sentry.io > projeto backend > Settings > Client Keys (DSN)
SENTRY_DSN=

# Produção (Render): domínio(s) do frontend que podem chamar essa API, em JSON
# (pydantic-settings parseia list[str] assim). Em dev local não precisa setar
# — o default em app/core/config.py já cobre http://localhost:3000.
# Ex.: ALLOWED_ORIGINS=["https://mapinha.vercel.app"]
ALLOWED_ORIGINS=

# "production" habilita comportamentos de produção (hoje só documentacional —
# ver app/core/config.py); em dev local não precisa setar.
ENVIRONMENT=
